{
  "name": "@joryio/web-sdk",
  "version": "1.3.1",
  "description": "Joryio Web Tracking SDK - Lightweight analytics and event tracking",
  "main": "dist/joryio.cjs.js",
  "module": "dist/joryio.mjs",
  "unpkg": "dist/joryio.min.js",
  "jsdelivr": "dist/joryio.min.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "module": {
        "types": "./dist/index.d.mts",
        "default": "./dist/joryio.mjs"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/joryio.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/joryio.cjs.js"
      }
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.spec.ts",
    "!src/core/test-harness.ts",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rollup -c",
    "build:watch": "rollup -c -w",
    "dev": "rollup -c -w",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist",
    "prepack": "npm run clean && npm run build"
  },
  "keywords": [
    "analytics",
    "tracking",
    "events",
    "marketing-automation",
    "joryio"
  ],
  "author": "Joryio",
  "license": "SEE LICENSE IN LICENSE",
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^11.1.5",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "babel-jest": "^29.7.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "rollup": "^4.9.2",
    "rollup-plugin-dts": "^6.1.0",
    "rollup-plugin-visualizer": "^5.12.0",
    "tslib": "^2.6.2",
    "typescript": "^5.3.3"
  },
  "homepage": "https://docs.joryio.com/developers/sdk/web-sdk",
  "repository": {
    "type": "git",
    "url": "https://github.com/joryio/joryio-web-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/joryio/joryio-web-sdk/issues",
    "email": "support@joryio.com"
  },
  "jest": {
    "testEnvironment": "node",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ]
  }
}
